<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <!-- Runs on .NET 9 or any newer runtime (students may only have .NET 10 installed). -->
    <RollForward>LatestMajor</RollForward>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <Import Project="..\..\AgentsPoker.Core.props" />
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <!-- netstandard 2.1 reference assembly: student .cs agents are compiled against it so the workbench accepts exactly
         the API the Unity Arena (Mono, .NET Standard 2.1) accepts. Copied to bin/.../ref/netstandard.dll. -->
    <PackageDownload Include="NETStandard.Library.Ref" Version="[2.1.0]" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(NuGetPackageRoot)netstandard.library.ref/2.1.0/ref/netstandard2.1/netstandard.dll"
          Link="ref/netstandard.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
