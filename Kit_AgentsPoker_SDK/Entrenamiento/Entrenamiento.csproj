<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tu laboratorio: entrena, mide y depura (breakpoints) tus agentes de Agents/. No se entrega.
       Ejecuta desde la carpeta del SDK con entrenar.cmd / entrenar.sh (ver Program.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Agents\Agentes.csproj" />
  </ItemGroup>
  <Import Project="..\AgentsPoker.Core.props" />
</Project>
